# Copy to .env. Never commit secrets or personal media.
DATABASE_URL=postgresql://vmerger:change-me@127.0.0.1:5432/vmerger
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=vmerger
S3_SECRET_KEY=change-me
S3_BUCKET=vmerger
# Required for live video analysis and the four creative agent roles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
# Single-owner MVP. Use a random value of at least 32 characters.
APP_TOKEN=
APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
SCRATCH_DIR=.local/scratch
MAX_UPLOAD_MB=500
MAX_ASSET_SECONDS=600
MAX_PROJECT_ASSETS=30
MAX_OUTPUT_SECONDS=300
